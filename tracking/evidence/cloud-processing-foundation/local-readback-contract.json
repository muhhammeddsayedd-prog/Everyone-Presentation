        "name": "job_events_read",
        "check": null,
        "roles": [
          "eps_jobs_owner"
        ],
        "table": "eps.job_events",
        "using": "(EXISTS ( SELECT 1\n   FROM eps.jobs job\n  WHERE (job.id = job_events.job_id)))",
        "command": "r",
        "permissive": true
      },
      {
        "name": "jobs_audit",
        "check": "((principal_id = auth.uid()) AND (action = ANY (ARRAY['jobs.enqueue'::text, 'jobs.retry'::text, 'jobs.cancel'::text])))",
        "roles": [
          "eps_jobs_owner"
        ],
        "table": "eps.audit_events",
        "using": null,
        "command": "a",
        "permissive": true
      },
      {
        "name": "jobs_idempotency",
        "check": "((principal_id = auth.uid()) AND (operation = ANY (ARRAY['jobs.enqueue'::text, 'jobs.retry'::text, 'jobs.cancel'::text])))",
        "roles": [
          "eps_jobs_owner"
        ],
        "table": "eps.idempotency_records",
        "using": "((principal_id = auth.uid()) AND (operation = ANY (ARRAY['jobs.enqueue'::text, 'jobs.retry'::text, 'jobs.cancel'::text])))",
        "command": "*",
        "permissive": true
      },
      {
        "name": "jobs_insert",
        "check": "((NOT eps.jobs_dispatch_mode()) AND (requested_by = auth.uid()) AND eps.jobs_can_access(workspace_id, 'enqueue'::text) AND (status = 'queued'::text) AND (stage = 'prepare_document'::text) AND (attempt = 0) AND (current_attempt_id IS NULL) AND (lease_token_digest IS NULL) AND (dispatch_generation = 1))",
        "roles": [
          "eps_jobs_owner"
        ],
        "table": "eps.jobs",
        "using": null,
        "command": "a",
        "permissive": true
      },
      {
        "name": "jobs_read",
        "check": null,
        "roles": [
          "eps_jobs_owner"
        ],
        "table": "eps.jobs",
        "using": "(eps.jobs_dispatch_mode() OR eps.jobs_can_access(workspace_id, 'read'::text) OR eps.jobs_can_access(workspace_id, 'enqueue'::text) OR eps.jobs_can_access(workspace_id, 'operate'::text))",
        "command": "r",
        "permissive": true
      },
      {
        "name": "jobs_update",
        "check": "(eps.jobs_dispatch_mode() OR eps.jobs_can_access(workspace_id, 'operate'::text))",
        "roles": [
          "eps_jobs_owner"
        ],
        "table": "eps.jobs",
        "using": "(eps.jobs_dispatch_mode() OR eps.jobs_can_access(workspace_id, 'operate'::text))",
        "command": "w",
        "permissive": true
      },
      {
        "name": "jobs_workspace_identity",
        "check": null,
        "roles": [
          "eps_jobs_owner"
        ],
        "table": "eps.workspaces",
        "using": "((archived_at IS NULL) AND eps.project_scope(project_id, false) AND (eps.has_capability('workspaces.read'::text) OR eps.has_capability('workspaces.write'::text) OR eps.has_capability('operations.read'::text) OR eps.has_capability('operations.retry'::text)))",
        "command": "r",
        "permissive": true
      },
      {
        "name": "outbox_insert",
        "check": "(eps.jobs_dispatch_mode() OR (EXISTS ( SELECT 1\n   FROM eps.jobs job\n  WHERE ((job.id = outbox_events.job_id) AND (eps.jobs_can_access(job.workspace_id, 'enqueue'::text) OR eps.jobs_can_access(job.workspace_id, 'operate'::text))))))",

# Configuration contract only. Empty values must be provided securely after discovery.
APP_ENV=development
APP_BASE_URL=http://127.0.0.1:3000
DEFAULT_TIMEZONE=Africa/Cairo
NEXT_PUBLIC_APP_NAME=Everyone Presentation Studio
CENTRAL_ADAPTER_MODE=local_fixture

# Central Supabase and discovered auth. Never expose privileged keys in NEXT_PUBLIC_*.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
DATABASE_URL=
SUPABASE_SERVER_KEY=
AUTH_ISSUER=
AUTH_AUDIENCE=
AUTH_JWKS_URL=

CAST_MEDIA_BUCKET=
PRESENTATION_BUCKET=
BRAND_ASSET_BUCKET=

# Remains false until the private Storage and verifier acceptance gate passes.
# Dedicated server-only 32-byte base64url key; matching private DB key is provisioned separately.
CENTRAL_LOGO_UPLOADS_ENABLED=false
LOGO_VERIFICATION_KEY_ID=
LOGO_VERIFICATION_KEY_BASE64URL=

# Independent original-document receipt key. This flag stays false until the
# purpose-aware private Storage/DB/worker and real HTTP acceptance gates pass.
CENTRAL_SPECS_UPLOADS_ENABLED=false
SPECS_VERIFICATION_KEY_ID=
SPECS_VERIFICATION_KEY_BASE64URL=

OPENAI_API_KEY=
OPENAI_EXTRACTION_MODEL=
OPENAI_TRANSCRIPTION_MODEL=
OPENAI_FRAME_MODEL=

# Server-only n8n management API inspection; optional private fallback is .env.worker.local.
# These do not restore the MCP connection or replace runtime webhook/callback credentials below.
N8N_API_KEY=
N8N_BASE_URL=

# Runtime workflow dispatch and callback authentication are separate from the management API key.
N8N_DISPATCH_URL=
N8N_DISPATCH_SECRET=
WORKFLOW_CALLBACK_SECRET=
WORKER_BASE_URL=http://localhost:4000
WORKER_SERVICE_SECRET=

SPECS_CONCURRENCY=2
VIDEO_CONCURRENCY=2
PDF_CONCURRENCY=1
JOB_MAX_ATTEMPTS=3
JOB_HEARTBEAT_SECONDS=20
JOB_LEASE_SECONDS=90
REVIEW_LINK_DEFAULT_DAYS=30
MEDIA_SIGNED_URL_MAX_SECONDS=60

MCP_RESOURCE_URL=
MCP_AUTH_ISSUER=
TELEMETRY_ENDPOINT=

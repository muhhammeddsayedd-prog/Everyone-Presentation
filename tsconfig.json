{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ES2023"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "paths": {
      "@eps/domain": [
        "./packages/domain/src/index.ts"
      ]
    },
    "allowImportingTsExtensions": true
  },
  "include": [
    "apps/**/*.ts",
    "apps/**/*.tsx",
    "packages/**/*.ts",
    "tests/**/*.ts",
    "tools/*.ts",
    "playwright.config.ts"
  ],
  "exclude": [
    "node_modules",
    "apps/web/.next",
    "Design Elements",
    ".agents",
    ".claude",
    "apps/web/.next-e2e"
  ]
}

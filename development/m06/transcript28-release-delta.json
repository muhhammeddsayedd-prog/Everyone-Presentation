    "policies|eps.presentation_video_transcripts.presentation_video_transcript_internal_read|cmd": "SELECT",
    "triggers|eps.presentation_video_transcripts.presentation_video_transcript_immutable|enabled": "O",
    "policies|eps.presentation_video_transcripts.presentation_video_transcript_capture|permissive": "PERMISSIVE",
    "policies|eps.presentation_video_transcripts.presentation_video_transcript_capture|with_check": "(((version_id)::text = current_setting('eps.presentation.transcript_capture_version'::text, true)) AND (EXISTS ( SELECT 1\n   FROM ((eps.presentation_versions v\n     JOIN eps.presentation_version_assets p ON (((p.version_id = v.id) AND (p.asset_id = presentation_video_transcripts.video_asset_id) AND (p.asset_kind = 'candidate_video'::text))))\n     JOIN eps.candidate_media m ON (((m.id = presentation_video_transcripts.candidate_media_id) AND (m.source_asset_id = p.asset_id))))\n  WHERE ((v.id = presentation_video_transcripts.version_id) AND (v.status = 'queued'::text) AND (v.generated_by = auth.uid()) AND eps.presentation_scope(v.workspace_id, true) AND (presentation_video_transcripts.captured_at = v.created_at) AND (presentation_video_transcripts.source_media_row_version = m.row_version) AND (EXISTS ( SELECT 1\n           FROM eps.version_slides d\n          WHERE ((d.version_id = v.id) AND (d.kind = 'candidate'::text) AND ((d.snapshot ->> 'candidate_media_id'::text) = (m.id)::text) AND ((d.snapshot ->> 'video_asset_id'::text) = (p.asset_id)::text)))) AND (((presentation_video_transcripts.status = 'available'::text) AND (presentation_video_transcripts.original_text = m.original_transcript) AND (presentation_video_transcripts.languages = m.languages)) OR ((presentation_video_transcripts.status = 'not_provided'::text) AND ((m.original_transcript IS NULL) OR (m.original_transcript !~ '[^\t\n\r    -     　﻿]'::text))))))))",
    "policies|eps.presentation_video_transcripts.presentation_video_transcript_internal_read|qual": "(EXISTS ( SELECT 1\n   FROM eps.presentation_versions v\n  WHERE ((v.id = presentation_video_transcripts.version_id) AND eps.presentation_scope(v.workspace_id))))",
    "constraints|eps.presentation_video_transcripts.presentation_video_transcripts_pkey|definition": "PRIMARY KEY (version_id, video_asset_id)",
    "policies|eps.presentation_video_transcripts.presentation_video_transcript_internal_read|roles": [
      "eps_review_owner"
    ],
    "constraints|eps.presentation_video_transcripts.presentation_video_transcripts_check|definition": "CHECK ((((status = 'available'::text) AND (original_text IS NOT NULL) AND eps.presentation_source_text_valid(original_text, 200000) AND (source_sha256 IS NOT NULL) AND (source_sha256 ~ '^[a-f0-9]{64}$'::text) AND (source_sha256 = encode(sha256(convert_to(original_text, 'UTF8'::name)), 'hex'::text))) OR ((status = 'not_provided'::text) AND (original_text IS NULL) AND (source_sha256 IS NULL) AND (languages = '{}'::text[]))))",
    "triggers|eps.presentation_video_transcripts.presentation_video_transcript_immutable|definition": "CREATE TRIGGER presentation_video_transcript_immutable BEFORE DELETE OR UPDATE ON eps.presentation_video_transcripts FOR EACH ROW EXECUTE FUNCTION eps.presentation_immutable_row()",
    "policies|eps.presentation_video_transcripts.presentation_video_transcript_guest_read|permissive": "PERMISSIVE",
    "policies|eps.presentation_video_transcripts.presentation_video_transcript_guest_read|with_check": null,
    "policies|eps.presentation_video_transcripts.presentation_video_transcript_internal_read|permissive": "PERMISSIVE",
    "policies|eps.presentation_video_transcripts.presentation_video_transcript_internal_read|with_check": null,
    "constraints|eps.presentation_video_transcripts.presentation_video_transcripts_status_check|definition": "CHECK ((status = ANY (ARRAY['available'::text, 'not_provided'::text])))",
    "constraints|eps.presentation_video_transcripts.presentation_video_transcripts_languages_check|definition": "CHECK (eps.presentation_source_languages_valid(languages))",
    "constraints|eps.presentation_video_transcripts.presentation_video_transcripts_candidate_media_id_fkey|definition": "FOREIGN KEY (candidate_media_id) REFERENCES eps.candidate_media(id) ON DELETE RESTRICT",
    "constraints|eps.presentation_video_transcripts.presentation_video_transcripts_source_media_row_version_check|definition": "CHECK (((source_media_row_version >= 1) AND (source_media_row_version <= '9007199254740991'::bigint)))",
    "constraints|eps.presentation_video_transcripts.presentation_video_transcripts_version_id_video_asset_id_fkey|definition": "FOREIGN KEY (version_id, video_asset_id) REFERENCES eps.presentation_version_assets(version_id, asset_id) ON DELETE RESTRICT"

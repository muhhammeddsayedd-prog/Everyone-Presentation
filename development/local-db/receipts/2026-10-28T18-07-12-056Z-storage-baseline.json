        {
          "oid": "17049",
          "owner": "supabase_storage_admin",
          "identity": "storage.allow_any_operation(text[])",
          "definition": "CREATE OR REPLACE FUNCTION storage.allow_any_operation(expected_operations text[])\n RETURNS boolean\n LANGUAGE sql\n STABLE\n SET search_path TO ''\nAS $function$\n    select exists(select 1 from unnest(expected_operations) expected_operation\n      where expected_operation is not null and expected_operation <> ''\n        and storage.allow_only_operation(expected_operation))\n  $function$\n"
        },
        {
          "oid": "17048",
          "owner": "supabase_storage_admin",
          "identity": "storage.allow_only_operation(text)",
          "definition": "CREATE OR REPLACE FUNCTION storage.allow_only_operation(expected_operation text)\n RETURNS boolean\n LANGUAGE sql\n STABLE\n SET search_path TO ''\nAS $function$\n    select coalesce(\n      case when storage.operation() like 'storage.%' then substr(storage.operation(),9) else storage.operation() end\n      = case when expected_operation like 'storage.%' then substr(expected_operation,9) else expected_operation end\n      and expected_operation <> '', false)\n  $function$\n"
        },
        {
          "oid": "17047",
          "owner": "supabase_storage_admin",
          "identity": "storage.operation()",
          "definition": "CREATE OR REPLACE FUNCTION storage.operation()\n RETURNS text\n LANGUAGE sql\n STABLE\n SET search_path TO ''\nAS $function$ select current_setting('storage.operation',true) $function$\n"
        }

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Fresh owner-verified development process quiescence for issuer30",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "observed_at", "target", "owned_processes_verified", "web_stopped", "worker_stopped", "owned_pids", "ownership_evidence"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "observed_at": {"type": "string", "format": "date-time", "description": "UTC-aware observation, age 0 through 900 seconds at apply"},
    "target": {"const": "pyibofyctwnqpvktepse"},
    "owned_processes_verified": {"const": true},
    "web_stopped": {"const": true},
    "worker_stopped": {"const": true},
    "owned_pids": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"type": "integer", "minimum": 1, "maximum": 2147483647}},
    "ownership_evidence": {"type": "string", "pattern": "^\\.local/", "description": "Existing exact workspace-private file; forward slashes, no absolute path or traversal. Its payload is not read or printed by this controller."}
  }
}

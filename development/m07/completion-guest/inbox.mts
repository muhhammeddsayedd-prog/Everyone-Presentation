/** Fresh owner handoff for one bounded anonymous feedback acceptance run. */
import { randomBytes, randomUUID } from 'node:crypto';
import type { BigIntStats } from 'node:fs';
import { lstat, mkdir, open, readFile, realpath, unlink } from 'node:fs/promises';
import path from 'node:path';
import { pathToFileURL } from 'node:url';
import { windowsInboxSecurity, type InboxSecurity } from '../../../tools/client-upload-inbox.mts';
import { readPrivateInput } from '../../../tools/client-upload-transfer.mts';
import { feedbackSummaryDto } from '../../../packages/domain/src/feedback-summary.ts';
import { closed, GuestDeltaError, need, sha, timestamp, token, uuid, validateGuestDenial, verifyGuestDenial } from '../guest-summary-delta/probe.mts';
import { confirmGuest, LIVE_WRITES_ENABLED, openGuest, parseInput, parseState } from './writer.mts';

const CODE_ROOT=path.resolve(import.meta.dirname,'../../..'),TTL=1800000;
const SOURCES=['development/m07/completion-guest/writer.mts','development/m07/completion-guest/inbox.mts','development/m07/guest-summary-delta/probe.mts','tools/client-upload-inbox.mts','tools/client-upload-transfer.mts','packages/domain/src/feedback-summary.ts','packages/domain/src/guest.ts'];
const identity=(value:BigIntStats)=>[value.dev,value.ino,value.size,value.mtimeNs,value.ctimeNs].map(String).join(':');
interface Options{workspaceRoot?:string;security?:InboxSecurity;fetch?:typeof fetch;now?:()=>number}
interface Manifest{schema_version:'1.0';run_id:string;nonce:string;version_id:string;version_slide_id:string;internal_comment_id:string;created_at:string;expires_at:string;sources:Record<string,string>}
async function regular(target:string,kind:'directory'|'file'){
 need(path.isAbsolute(target)&&!target.startsWith('\\'));const resolved=path.resolve(target);need(await realpath(resolved)===resolved);let at=path.parse(resolved).root;
 for(const part of path.relative(at,resolved).split(path.sep)){at=path.join(at,part);need(!(await lstat(at)).isSymbolicLink());}
 const stat=await lstat(resolved,{bigint:true});need(kind==='directory'?stat.isDirectory():stat.isFile()&&stat.nlink===1n);return stat;
}
async function sourceSeals(){const result:Record<string,string>={};for(const file of SOURCES){await regular(path.join(CODE_ROOT,file),'file');result[file]=sha(await readFile(path.join(CODE_ROOT,file)));}return result;}
export function makeGuestWriteInbox(options:Options={}){
 const workspace=path.resolve(options.workspaceRoot??CODE_ROOT),base=path.join(workspace,'.local/completion-guest'),security=options.security??windowsInboxSecurity(),now=options.now??Date.now;
 async function readPrivate(file:string){const before=await regular(file,'file');need(before.size>0n&&before.size<=65536n);await security.verify(file,'file');const handle=await open(file,'r'),buffer=Buffer.alloc(65537);let size=0;
  try{need(identity(await handle.stat({bigint:true}))===identity(before));for(;;){const part=await handle.read(buffer,size,buffer.length-size,null);if(!part.bytesRead)break;size+=part.bytesRead;need(size<=65536);}need(identity(await regular(file,'file'))===identity(before)&&identity(await handle.stat({bigint:true}))===identity(before));return{value:await readPrivateInput((async function*(){yield buffer.subarray(0,size);})()),sha:sha(buffer.subarray(0,size)),identity:identity(before)};}finally{buffer.fill(0);await handle.close();}}
 async function writePrivate(file:string,value:unknown){await regular(path.dirname(file),'directory');await security.verify(path.dirname(file),'directory');const bytes=JSON.stringify(value);need(Buffer.byteLength(bytes)<=65536);const handle=await open(file,'wx',0o600);try{await handle.writeFile(bytes);await handle.sync();}finally{await handle.close();}await security.verify(file,'file');}
 async function receipt(runId:string,phase:string,value:unknown){let dir=workspace;for(const part of['tracking','evidence','m07','completion-guest']){dir=path.join(dir,part);try{await mkdir(dir);}catch(error){need((error as NodeJS.ErrnoException).code==='EEXIST');}await regular(dir,'directory');}const file=path.join(dir,`${new Date(now()).toISOString().replaceAll(':','-')}-${runId}-${randomUUID()}-${phase}.json`),handle=await open(file,'wx');try{await handle.writeFile(JSON.stringify(value,null,2)+'\n');await handle.sync();}finally{await handle.close();}return file;}
 async function load(value:unknown,fresh=true){const request=closed(value,['run_id','manifest_sha256']);const id=uuid(request.run_id);need(typeof request.manifest_sha256==='string'&&/^[a-f0-9]{64}$/u.test(request.manifest_sha256));const dir=path.join(base,id);await regular(dir,'directory');await security.verify(dir,'directory');const read=await readPrivate(path.join(dir,'manifest.json'));need(read.sha===request.manifest_sha256);const row=closed(read.value,['schema_version','run_id','nonce','version_id','version_slide_id','internal_comment_id','created_at','expires_at','sources']);need(row.schema_version==='1.0'&&row.run_id===id);uuid(row.version_id);uuid(row.version_slide_id);uuid(row.internal_comment_id);token(row.nonce);timestamp(row.created_at);timestamp(row.expires_at);need(JSON.stringify(row.sources)===JSON.stringify(await sourceSeals())&&Date.parse(row.expires_at as string)-Date.parse(row.created_at as string)===TTL);need(now()>=Date.parse(row.created_at as string)-5000&&now()-Date.parse(row.created_at as string)<(fresh?TTL:3600000));return{dir,manifest:row as unknown as Manifest,manifest_sha256:request.manifest_sha256};}
 async function prepare(value:unknown){const row=closed(value,['version_id','version_slide_id','internal_comment_id']);uuid(row.version_id);uuid(row.version_slide_id);uuid(row.internal_comment_id);await regular(workspace,'directory');for(const dir of[path.join(workspace,'.local'),base]){try{await mkdir(dir,{mode:0o700});}catch(error){need((error as NodeJS.ErrnoException).code==='EEXIST');}await regular(dir,'directory');}const run_id=randomUUID(),dir=path.join(base,run_id);await mkdir(dir,{mode:0o700});await security.protect(dir);await security.verify(dir,'directory');const created=now();need(Number.isSafeInteger(created));const manifest:Manifest={schema_version:'1.0',run_id,nonce:randomBytes(32).toString('base64url'),version_id:row.version_id as string,version_slide_id:row.version_slide_id as string,internal_comment_id:row.internal_comment_id as string,created_at:new Date(created).toISOString(),expires_at:new Date(created+TTL).toISOString(),sources:await sourceSeals()};await writePrivate(path.join(dir,'manifest.json'),manifest);return{result:'prepared',run_id,nonce:manifest.nonce,manifest_sha256:sha(JSON.stringify(manifest)),handoff_file:path.join(dir,'handoff.json'),expires_at:manifest.expires_at,live_writes_enabled:LIVE_WRITES_ENABLED};}
 async function openSession(value:unknown){need(LIVE_WRITES_ENABLED||Boolean(options.fetch));const loaded=await load(value),file=path.join(loaded.dir,'handoff.json'),read=await readPrivate(file),row=closed(read.value,['schema_version','run_id','nonce','manifest_sha256','guest']);need(row.schema_version==='1.0'&&row.run_id===loaded.manifest.run_id&&row.nonce===loaded.manifest.nonce&&row.manifest_sha256===loaded.manifest_sha256);const input=parseInput(row.guest);need(input.run_id===loaded.manifest.run_id&&input.version_id===loaded.manifest.version_id&&input.version_slide_id===loaded.manifest.version_slide_id&&input.internal_comment_id===loaded.manifest.internal_comment_id);need(now()<Date.parse(input.link_expires_at));await writePrivate(path.join(loaded.dir,'open-dispatched.json'),{run_id:input.run_id,automatic_retry:false});need(identity(await regular(file,'file'))===read.identity);await unlink(file);
  try{const state=await openGuest(input,{fetch:options.fetch,now});await writePrivate(path.join(loaded.dir,'session.json'),state);return{result:'opened',run_id:input.run_id,next:'Explicit confirm posts one named external comment; session and stable keys are already protected on disk.'};}catch{await receipt(input.run_id,'open-unconfirmed',{result:'unconfirmed',automatic_retry:false,owner_revoke_required:true});throw new GuestDeltaError();}}
 async function confirm(value:unknown,resume=false){need(LIVE_WRITES_ENABLED||Boolean(options.fetch));const loaded=await load(value),sessionFile=path.join(loaded.dir,'session.json'),read=await readPrivate(sessionFile),state=parseState(read.value);need(state.input.run_id===loaded.manifest.run_id&&state.input.version_id===loaded.manifest.version_id&&state.input.version_slide_id===loaded.manifest.version_slide_id&&state.input.internal_comment_id===loaded.manifest.internal_comment_id);try{await lstat(path.join(loaded.dir,'confirmed.json'));throw new GuestDeltaError();}catch(error){need((error as NodeJS.ErrnoException).code==='ENOENT');}if(resume)await readPrivate(path.join(loaded.dir,'confirm-unconfirmed.json'));await writePrivate(path.join(loaded.dir,resume?'resume-dispatched.json':'confirm-dispatched.json'),{run_id:state.input.run_id,explicit_confirmation:true,same_body_and_keys:true,automatic_retry:false});
  try{const result=await confirmGuest(state,{fetch:options.fetch,now});await writePrivate(path.join(loaded.dir,'confirmed.json'),result);const receipt_file=await receipt(state.input.run_id,'confirmed',{...result,manifest_sha256:loaded.manifest_sha256,source_seals:loaded.manifest.sources});return{result:'passed',run_id:state.input.run_id,comment_id:result.comment_id,receipt_file,owner_revoke_required:true};}catch{if(!resume)await writePrivate(path.join(loaded.dir,'confirm-unconfirmed.json'),{result:'unconfirmed',automatic_retry:false,explicit_same_key_resume_available:true});await receipt(state.input.run_id,resume?'resume-unconfirmed':'confirm-unconfirmed',{result:'unconfirmed',automatic_retry:false,explicit_same_key_resume_available:!resume,owner_revoke_required:true});throw new GuestDeltaError();}}
 async function deny(value:unknown){need(LIVE_WRITES_ENABLED||Boolean(options.fetch));const row=closed(value,['run_id','manifest_sha256','reason']);need(row.reason==='expired'||row.reason==='revoked');const loaded=await load({run_id:row.run_id,manifest_sha256:row.manifest_sha256},false),file=path.join(loaded.dir,'session.json'),read=await readPrivate(file),state=parseState(read.value);const confirmed=(await readPrivate(path.join(loaded.dir,'confirmed.json'))).value as Awaited<ReturnType<typeof confirmGuest>>;need(confirmed.run_id===state.input.run_id&&confirmed.result==='passed');const session=validateGuestDenial({schema_version:'1.0',review_link_id:state.input.review_link_id,series_id:state.input.series_id,version_id:state.input.version_id,review_token:state.input.review_token,session_token:state.session_token,session_expires_at:state.session_expires_at,link_expires_at:state.input.link_expires_at,opened_at:state.opened_at,summary_sha256:sha(JSON.stringify(feedbackSummaryDto(confirmed.summary_after)))},row.reason,now());await writePrivate(path.join(loaded.dir,'denial-dispatched.json'),{run_id:state.input.run_id,reason:row.reason,automatic_retry:false});const result=await verifyGuestDenial(session,row.reason,{fetch:options.fetch,now});need(identity(await regular(file,'file'))===read.identity);await unlink(file);const receipt_file=await receipt(state.input.run_id,'denied',{...result,source_seals:loaded.manifest.sources,private_session_file_removed:true,feedback_deleted:false});return{result:'passed',run_id:state.input.run_id,receipt_file,private_session_file_removed:true};}
 const guarded=<T,>(fn:(value:unknown)=>Promise<T>)=>async(value:unknown)=>{try{return await fn(value);}catch{throw new GuestDeltaError();}};
 return{prepare:guarded(prepare),open:guarded(openSession),confirm:guarded(value=>confirm(value)),resume:guarded(value=>confirm(value,true)),deny:guarded(deny)};
}
export async function runCli(argv:string[]){try{const [action,...args]=argv;need(args.length%2===0);const pairs:Record<string,string>={};for(let i=0;i<args.length;i+=2){need(args[i].startsWith('--')&&!Object.hasOwn(pairs,args[i]));pairs[args[i]]=args[i+1];}const tool=makeGuestWriteInbox();if(action==='prepare'){closed(pairs,['--version-id','--slide-id','--internal-comment-id']);return await tool.prepare({version_id:pairs['--version-id'],version_slide_id:pairs['--slide-id'],internal_comment_id:pairs['--internal-comment-id']});}if(action==='deny'){closed(pairs,['--run-id','--manifest-sha','--reason']);return await tool.deny({run_id:pairs['--run-id'],manifest_sha256:pairs['--manifest-sha'],reason:pairs['--reason']});}need(action==='open'||action==='confirm'||action==='resume');closed(pairs,['--run-id','--manifest-sha']);return await tool[action]({run_id:pairs['--run-id'],manifest_sha256:pairs['--manifest-sha']});}catch{return{result:'failed',code:'GUEST_WRITE_UNCONFIRMED',automatic_retry:false};}}
if(process.argv[1]&&pathToFileURL(path.resolve(process.argv[1])).href===import.meta.url)void runCli(process.argv.slice(2)).then(result=>{process.stdout.write(JSON.stringify(result)+'\n');if(result.result==='failed')process.exitCode=1;});

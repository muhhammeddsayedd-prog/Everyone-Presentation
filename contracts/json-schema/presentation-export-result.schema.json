{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.everyone.example/presentation-export-result.schema.json",
  "title": "Validated link-scoped PDF export result",
  "description": "Closed M06 native worker callback. Exact frozen content and independently validated PDF proofs accompany scoped IDs. No bearer token or URL is permitted. This does not expose renderer snapshots to guests.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "version_id": {
      "$ref": "#/$defs/Id"
    },
    "export_id": {
      "$ref": "#/$defs/Id"
    },
    "review_link_id": {
      "$ref": "#/$defs/Id"
    },
    "export_revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "grant_id": {
      "$ref": "#/$defs/Id"
    },
    "snapshot_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "manifest_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "inventory_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "pdf_asset": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "asset_id": {
          "$ref": "#/$defs/Id"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 67108864
        },
        "mime_type": {
          "const": "application/pdf"
        }
      },
      "required": [
        "asset_id",
        "sha256",
        "size_bytes",
        "mime_type"
      ]
    },
    "render_proof": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "renderer_version": {
          "const": "everyone-casting-pdf-v1"
        },
        "chromium_version": {
          "type": "string",
          "pattern": "^[0-9]+(?:\\.[0-9]+){2,3}$"
        },
        "template_content_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "font_hashes": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 12,
          "additionalProperties": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "page_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "width_css_px": {
          "const": 1600
        },
        "height_css_px": {
          "const": 900
        },
        "overflow_count": {
          "const": 0
        },
        "candidate_field_count": {
          "type": "integer",
          "minimum": 0
        },
        "frame_draw_count": {
          "type": "integer",
          "minimum": 0
        },
        "logo_draw_count": {
          "type": "integer",
          "minimum": 0
        },
        "video_link_count": {
          "type": "integer",
          "minimum": 0
        },
        "fonts_ready": {
          "const": true
        },
        "images_ready": {
          "const": true
        },
        "link_targets_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "rendered_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "renderer_version",
        "chromium_version",
        "template_content_sha256",
        "font_hashes",
        "page_count",
        "width_css_px",
        "height_css_px",
        "overflow_count",
        "candidate_field_count",
        "frame_draw_count",
        "logo_draw_count",
        "video_link_count",
        "fonts_ready",
        "images_ready",
        "link_targets_sha256",
        "rendered_at"
      ]
    },
    "validation_proof": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pdf_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "page_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "width_points": {
          "type": "number",
          "minimum": 1199.5,
          "maximum": 1200.5
        },
        "height_points": {
          "type": "number",
          "minimum": 674.5,
          "maximum": 675.5
        },
        "text_regions_checked": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "image_draws_checked": {
          "type": "integer",
          "minimum": 0
        },
        "video_links_checked": {
          "type": "integer",
          "minimum": 0
        },
        "embedded_font_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6000
        },
        "validated_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "pdf_sha256",
        "page_count",
        "width_points",
        "height_points",
        "text_regions_checked",
        "image_draws_checked",
        "video_links_checked",
        "embedded_font_count",
        "validated_at"
      ]
    }
  },
  "required": [
    "schema_version",
    "version_id",
    "export_id",
    "review_link_id",
    "export_revision",
    "grant_id",
    "snapshot_sha256",
    "manifest_sha256",
    "inventory_sha256",
    "pdf_asset",
    "render_proof",
    "validation_proof"
  ],
  "$defs": {
    "Id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "Opaque resource identifier. Do not parse business meaning or assume source database PK type."
    }
  }
}

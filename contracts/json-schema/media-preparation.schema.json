{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.everyone.example/media-preparation.schema.json",
  "title": "Prepared candidate media",
  "description": "Application contract. Adapt supported provider JSON Schema subset and validate again server-side. Example domain is not a live service.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "source_asset_id": {
      "$ref": "#/$defs/Id"
    },
    "preview_asset_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/Id"
        },
        {
          "type": "null"
        }
      ]
    },
    "audio_chunks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "asset_id": {
            "$ref": "#/$defs/Id"
          },
          "start_ms": {
            "type": "integer",
            "minimum": 0
          },
          "end_ms": {
            "type": "integer",
            "minimum": 0
          },
          "overlap_ms": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "asset_id",
          "start_ms",
          "end_ms",
          "overlap_ms"
        ]
      }
    },
    "frames": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Frame"
      }
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 0
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "source_asset_id",
    "preview_asset_id",
    "audio_chunks",
    "frames",
    "duration_ms",
    "warnings"
  ],
  "$defs": {
    "Frame": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "asset_id": {
          "$ref": "#/$defs/Id"
        },
        "source_asset_id": {
          "$ref": "#/$defs/Id"
        },
        "timestamp_ms": {
          "type": "integer",
          "minimum": 0
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "quality_flags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "asset_id",
        "source_asset_id",
        "timestamp_ms",
        "width",
        "height",
        "quality_flags"
      ]
    },
    "Id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "Opaque resource identifier. Do not parse business meaning or assume source database PK type."
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.everyone.example/slide-wording.schema.json",
  "title": "Slide wording assistance",
  "description": "Application contract. Adapt supported provider JSON Schema subset and validate again server-side. Example domain is not a live service.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "type": "string"
    },
    "assignment_id": {
      "$ref": "#/$defs/Id"
    },
    "field": {
      "type": "string"
    },
    "suggested_text": {
      "type": "string"
    },
    "facts_preserved": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "schema_version",
    "assignment_id",
    "field",
    "suggested_text",
    "facts_preserved",
    "warnings"
  ],
  "$defs": {
    "Id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "Opaque resource identifier. Do not parse business meaning or assume source database PK type."
    }
  }
}
